# Local development: create a dedicated database before starting.
DATABASE_URL=postgres://spice:change-this-password@127.0.0.1:5432/spicenrice?sslmode=disable
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=
FRONTEND_ORIGIN=http://127.0.0.1:5175
LISTEN_ADDR=:8087
COOKIE_SECURE=false
# Enable only behind a local reverse proxy that overwrites X-Real-IP.
TRUST_LOOPBACK_PROXY=false
UPLOAD_DIR=uploads
# Optional absolute path to cwebp; otherwise it must be on PATH.
CWEBP_PATH=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# Used only by the optional Compose configuration.
POSTGRES_PASSWORD=
