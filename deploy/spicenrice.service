[Unit]
Description=Spice N Rice API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spicenrice
Group=spicenrice
WorkingDirectory=/opt/spicenrice/backend
EnvironmentFile=/etc/spicenrice.env
Environment=LISTEN_ADDR=127.0.0.1:8087
Environment=UPLOAD_DIR=/var/lib/spicenrice/uploads
Environment=MIGRATIONS_DIR=/opt/spicenrice/backend/migrations
Environment=TRUST_LOOPBACK_PROXY=true
Environment=COOKIE_SECURE=true
ExecStart=/opt/spicenrice/backend/spice-api
Restart=on-failure
RestartSec=3
StateDirectory=spicenrice
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/spicenrice

[Install]
WantedBy=multi-user.target
